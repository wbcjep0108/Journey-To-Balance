# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Local secrets / env (never commit)
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
**/.dev.vars

# Firebase / Google service account private keys
*firebase-adminsdk*.json
*service-account*.json
*serviceaccount*.json
**/serviceAccountKey.json
**/credentials.json
*.pem
*.p12

# Android signing (keep key.properties / keystores private)
**/key.properties
**/*.jks
**/*.keystore

# Cursor / agent / debug session artifacts
.cursor/
.agents/
skills-lock.json
debug-*.log
**/agent-transcripts/

# Probe / local tool output
tool/*_run.log
tool/*.log

# Firebase CLI local artifacts
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Node (Worker + legacy functions)
**/node_modules/
**/.wrangler/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
