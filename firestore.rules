rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Own user doc (budget map includes savings goal fields).
      // Realtime listeners: users/{uid}.snapshots()
      // Financial writes go through Cloudflare Worker (service account).
      allow read: if isOwner(userId);
      allow write: if false;

      // Category entry collections — list/get for owner only.
      // Realtime listeners: users/{uid}/{bills|savings|personal}.snapshots()
      match /bills/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /savings/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /personal/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Synced wallet data: cash, currency, cards, loans.
      // Path: users/{uid}/wallet/{docId} (client uses doc id "data").
      // Unlike budget/entries (Worker-only writes), wallet is self-owned state
      // written directly by the authenticated owner from any of their devices.
      // Realtime listeners: users/{uid}/wallet/data.snapshots()
      match /wallet/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Rate limits / idempotency (legacy or future) — never client-accessible.
      // Must stay deny-all: overlapping rules use OR, so a broader owner-read
      // catch-all would reopen security/** to the owner.
      match /security/{document=**} {
        allow read, write: if false;
      }

      // Any other subcollection under the user — deny.
      // Explicit matches above still grant owner reads via OR.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Everything outside /users/{uid} — deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
