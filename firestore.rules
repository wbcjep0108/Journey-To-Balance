rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed planner model: users/{uid}.planner is a required-key map with
    // one active plan. Dates are timestamps, amounts are bounded numbers, and
    // category switches determine which positive amounts form the total.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidPlannerAmount(enabled, amount) {
      return enabled is bool &&
        amount is number &&
        amount >= 0 &&
        amount <= 1000000000000 &&
        ((enabled && amount > 0) || (!enabled && amount == 0));
    }

    function isValidBudgetPlan(planner) {
      let sum = planner.billsAmount +
        planner.savingsAmount +
        planner.personalAmount;
      return planner is map &&
        planner.keys().hasAll([
          'id', 'period', 'startAt', 'endAt',
          'billsEnabled', 'billsAmount',
          'savingsEnabled', 'savingsAmount',
          'personalEnabled', 'personalAmount',
          'total', 'createdAt', 'alertEligible'
        ]) &&
        planner.keys().hasOnly([
          'id', 'period', 'startAt', 'endAt',
          'billsEnabled', 'billsAmount',
          'savingsEnabled', 'savingsAmount',
          'personalEnabled', 'personalAmount',
          'total', 'createdAt', 'alertEligible', 'thirteenthMonth'
        ]) &&
        planner.id is string &&
        planner.id.size() > 0 &&
        planner.id.size() <= 64 &&
        planner.period is string &&
        planner.period in ['day', 'week', 'month'] &&
        planner.startAt is timestamp &&
        planner.endAt is timestamp &&
        planner.endAt > planner.startAt &&
        planner.createdAt is timestamp &&
        (
          (
            planner.createdAt > request.time - duration.value(10, 'm') &&
            planner.createdAt < request.time + duration.value(10, 'm')
          ) ||
          (
            resource != null &&
            resource.data.keys().hasAny(['planner']) &&
            resource.data.planner is map &&
            resource.data.planner.keys().hasAny(['createdAt']) &&
            planner.createdAt == resource.data.planner.createdAt
          )
        ) &&
        planner.alertEligible is bool &&
        isValidPlannerAmount(
          planner.billsEnabled,
          planner.billsAmount
        ) &&
        isValidPlannerAmount(
          planner.savingsEnabled,
          planner.savingsAmount
        ) &&
        isValidPlannerAmount(
          planner.personalEnabled,
          planner.personalAmount
        ) &&
        (planner.billsEnabled ||
          planner.savingsEnabled ||
          planner.personalEnabled) &&
        planner.total is number &&
        planner.total > 0 &&
        planner.total <= 3000000000000 &&
        planner.total >= sum - 0.01 &&
        planner.total <= sum + 0.01;
    }

    function isValidThirteenthMonth(value) {
      return value is map &&
        value.keys().hasAll([
          'year', 'monthlyBasicSalaries', 'otherBenefits', 'updatedAt'
        ]) &&
        value.keys().hasOnly([
          'year', 'monthlyBasicSalaries', 'otherBenefits', 'updatedAt'
        ]) &&
        value.year is int &&
        value.year >= 2000 &&
        value.year <= 2200 &&
        value.monthlyBasicSalaries is list &&
        value.monthlyBasicSalaries.size() == 12 &&
        value.monthlyBasicSalaries[0] is number &&
        value.monthlyBasicSalaries[0] >= 0 &&
        value.monthlyBasicSalaries[0] <= 1000000000000 &&
        value.monthlyBasicSalaries[1] is number &&
        value.monthlyBasicSalaries[1] >= 0 &&
        value.monthlyBasicSalaries[1] <= 1000000000000 &&
        value.monthlyBasicSalaries[2] is number &&
        value.monthlyBasicSalaries[2] >= 0 &&
        value.monthlyBasicSalaries[2] <= 1000000000000 &&
        value.monthlyBasicSalaries[3] is number &&
        value.monthlyBasicSalaries[3] >= 0 &&
        value.monthlyBasicSalaries[3] <= 1000000000000 &&
        value.monthlyBasicSalaries[4] is number &&
        value.monthlyBasicSalaries[4] >= 0 &&
        value.monthlyBasicSalaries[4] <= 1000000000000 &&
        value.monthlyBasicSalaries[5] is number &&
        value.monthlyBasicSalaries[5] >= 0 &&
        value.monthlyBasicSalaries[5] <= 1000000000000 &&
        value.monthlyBasicSalaries[6] is number &&
        value.monthlyBasicSalaries[6] >= 0 &&
        value.monthlyBasicSalaries[6] <= 1000000000000 &&
        value.monthlyBasicSalaries[7] is number &&
        value.monthlyBasicSalaries[7] >= 0 &&
        value.monthlyBasicSalaries[7] <= 1000000000000 &&
        value.monthlyBasicSalaries[8] is number &&
        value.monthlyBasicSalaries[8] >= 0 &&
        value.monthlyBasicSalaries[8] <= 1000000000000 &&
        value.monthlyBasicSalaries[9] is number &&
        value.monthlyBasicSalaries[9] >= 0 &&
        value.monthlyBasicSalaries[9] <= 1000000000000 &&
        value.monthlyBasicSalaries[10] is number &&
        value.monthlyBasicSalaries[10] >= 0 &&
        value.monthlyBasicSalaries[10] <= 1000000000000 &&
        value.monthlyBasicSalaries[11] is number &&
        value.monthlyBasicSalaries[11] >= 0 &&
        value.monthlyBasicSalaries[11] <= 1000000000000 &&
        value.otherBenefits is number &&
        value.otherBenefits >= 0 &&
        value.otherBenefits <= 1000000000000 &&
        value.updatedAt is timestamp;
    }

    function hasBudgetPlan(planner) {
      return planner.keys().hasAny([
        'id', 'period', 'startAt', 'endAt',
        'billsEnabled', 'billsAmount',
        'savingsEnabled', 'savingsAmount',
        'personalEnabled', 'personalAmount',
        'total', 'createdAt', 'alertEligible'
      ]);
    }

    function isValidPlanner(planner) {
      return planner is map &&
        planner.keys().hasOnly([
          'id', 'period', 'startAt', 'endAt',
          'billsEnabled', 'billsAmount',
          'savingsEnabled', 'savingsAmount',
          'personalEnabled', 'personalAmount',
          'total', 'createdAt', 'alertEligible', 'thirteenthMonth'
        ]) &&
        (hasBudgetPlan(planner) ||
          planner.keys().hasAny(['thirteenthMonth'])) &&
        ((!hasBudgetPlan(planner)) || isValidBudgetPlan(planner)) &&
        ((!planner.keys().hasAny(['thirteenthMonth'])) ||
          isValidThirteenthMonth(planner.thirteenthMonth));
    }

    function isValidLegalAcceptance(docId, acceptance) {
      return docId.matches('^acceptance_.+$') &&
        acceptance.keys().hasAll([
          'termsAcceptedAt', 'termsVersion', 'privacyVersion'
        ]) &&
        acceptance.keys().hasOnly([
          'termsAcceptedAt', 'termsVersion', 'privacyVersion'
        ]) &&
        acceptance.termsAcceptedAt is timestamp &&
        acceptance.termsAcceptedAt == request.time &&
        acceptance.termsVersion is string &&
        acceptance.termsVersion.size() >= 1 &&
        acceptance.termsVersion.size() <= 32 &&
        acceptance.privacyVersion is string &&
        acceptance.privacyVersion.size() >= 1 &&
        acceptance.privacyVersion.size() <= 32;
    }

    match /users/{userId} {
      // Own user doc (budget map includes savings goal fields).
      // Realtime listeners: users/{uid}.snapshots()
      // Financial writes go through Cloudflare Worker (service account).
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['planner']) &&
        isValidPlanner(request.resource.data.planner);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['planner']) &&
        (
          (!request.resource.data.keys().hasAny(['planner'])) ||
          isValidPlanner(request.resource.data.planner)
        );
      allow delete: if false;

      // Category entry collections — list/get for owner only.
      // Realtime listeners: users/{uid}/{bills|savings|personal}.snapshots()
      match /bills/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /savings/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /personal/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Synced wallet data: cash, currency, cards, loans.
      // Path: users/{uid}/wallet/{docId} (client uses doc id "data").
      // Unlike budget/entries (Worker-only writes), wallet is self-owned state
      // written directly by the authenticated owner from any of their devices.
      // Realtime listeners: users/{uid}/wallet/data.snapshots()
      match /wallet/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Owner-only, immutable consent receipts. Exact keys and request.time
      // make client-created records auditable without granting update access.
      match /legal/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidLegalAcceptance(docId, request.resource.data);
        allow update, delete: if false;
      }

      // Rate limits / idempotency (legacy or future) — never client-accessible.
      // Must stay deny-all: overlapping rules use OR, so a broader owner-read
      // catch-all would reopen security/** to the owner.
      match /security/{document=**} {
        allow read, write: if false;
      }

      // Any other subcollection under the user — deny.
      // Explicit matches above still grant owner reads via OR.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Everything outside /users/{uid} — deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
